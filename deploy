#!/usr/bin/env bash
# Builds the site and deploys it to the server: ./bundle, then ./ship. See "Deployment" in
# README.md.
set -euo pipefail

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

OUT_DIR=$(mktemp -d)
trap 'rm -rf "${OUT_DIR}"' EXIT

"${SCRIPT_DIR}/bundle" "${OUT_DIR}"
"${SCRIPT_DIR}/ship" "${OUT_DIR}/site-bundle.zip"
