#!/usr/bin/env bash

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

BUNDLE_DIR=/tmp/site-bundle

SERVER_VERSION=0.0.1-SNAPSHOT

EC2_USER=ec2-user
DOMAIN=zyoussef.com
SERVER_ROOT=/home/${EC2_USER}

# Create temporary directory for assembling server bundle
mkdir -p ${BUNDLE_DIR}
# Clean temp directory if it exists
rm -r ${BUNDLE_DIR}/*

# Build frontend
cd ${SCRIPT_DIR}/frontend
npm run build
# Copy output to bundle
cp -r build ${BUNDLE_DIR}/
# Move assets to bundle root
mv ${BUNDLE_DIR}/build/assets ${BUNDLE_DIR}/

# Build backend
cd ${SCRIPT_DIR}/graphql-server
./gradlew build
# Copy output to bundle
cp build/libs/graphql-server-${SERVER_VERSION}-standalone.jar ${BUNDLE_DIR}/
# Add backend assets to bundle
cp -r assets ${BUNDLE_DIR}/

# Insert startup script and the https proxy's config into bundle
cp ${SCRIPT_DIR}/server-restart ${BUNDLE_DIR}/
cp ${SCRIPT_DIR}/Caddyfile ${BUNDLE_DIR}/

# Zip bundle. zip adds to an existing archive, so start a new one each time, or files
# from earlier deploys, like old frontend bundles, would keep shipping.
cd ${BUNDLE_DIR}
rm -f ${BUNDLE_DIR}.zip
zip -r ${BUNDLE_DIR}.zip *

# Transfer bundle to server
scp ${BUNDLE_DIR}.zip ${EC2_USER}@${DOMAIN}:${SERVER_ROOT}/

# Unzip bundle on server
ssh ${EC2_USER}@${DOMAIN} "unzip -o site-bundle.zip"
# Restart Server
ssh ${EC2_USER}@${DOMAIN} "./server-restart"

# Delete files that earlier deploys left behind and nothing uses any more. Unzipping only
# adds and overwrites, so changes that make a server path obsolete list it, relative to
# the server's home directory, on its own line in .server_tombstones (a directory goes
# with everything in it). The list is deleted once the server has removed them.
TOMBSTONES=${SCRIPT_DIR}/.server_tombstones
if [ -f "${TOMBSTONES}" ]; then
    paths=()
    while IFS= read -r path || [ -n "${path}" ]; do
        [ -z "${path}" ] && continue
        case "${path}" in
            /*|..|../*|*/..|*/../*)
                echo "Not deleting ${path}: tombstones must be inside ${SERVER_ROOT}" >&2
                exit 1;;
        esac
        # Keeps what was just deployed, e.g. a listed bundle this build reproduced, or a
        # typo like "assets"
        if [ -e "${BUNDLE_DIR}/${path}" ]; then
            echo "Not deleting ${path}: this deploy ships it" >&2
            continue
        fi
        paths+=("${path}")
    done < "${TOMBSTONES}"

    if [ ${#paths[@]} -eq 0 ] || printf '%s\0' "${paths[@]}" |
            ssh ${EC2_USER}@${DOMAIN} "cd ${SERVER_ROOT} && xargs -0 rm -rfv --"; then
        rm "${TOMBSTONES}"
    else
        echo "Deleting tombstones on the server failed; keeping ${TOMBSTONES}" >&2
        exit 1
    fi
fi
